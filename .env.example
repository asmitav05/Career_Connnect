# ==============================================================================
# CareerConnect Environment Configuration
# ==============================================================================

# Server Port
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# CareerConnect includes a high-performance persistent relational engine (db/careerconnect.db)
# that works immediately out of the box with zero setup.
#
# To connect your own Supabase PostgreSQL project:
# 1. Create a free project at https://supabase.com
# 2. In the Supabase Dashboard, go to Project Settings -> API
# 3. Copy your Project URL and Project API Keys (anon / service_role)
# 4. In the SQL Editor, execute db/schema.sql to apply the production schema & RLS policies
# 5. Populate the variables below:

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Optional: Direct PostgreSQL Connection URI (if connecting via direct pooler)
# DATABASE_URL=postgresql://postgres:yourpassword@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# AUTHENTICATION & GOOGLE SIGN-IN CONFIGURATION
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Client ID (Web Client)
# Create in https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
